# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment / secrets ────────────────────────────────────
.env
*.env.local

# ── IDE ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Models (large binary files) ──────────────────────────────
models/*.pt
models/*.onnx
models/*.weights
!models/.gitkeep

# ── Generated output ─────────────────────────────────────────
data/output/*
!data/output/.gitkeep
data/sample_pids/*.pdf

# ── Temporary / debug files ──────────────────────────────────
debug_ocr.py
data/output/temp/
*.log

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Distribution ─────────────────────────────────────────────
dist/
build/
*.egg-info/
