# ============================================================
# P&ID MTO Extraction System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and will NEVER be committed.
#
# Every value below matches the code default in config/settings.py.
# Relative paths are resolved against the project root, so they work
# no matter which directory you launch the app from.

# ------------------------------------------------------------
# Groq API Key (OPTIONAL — pipeline works without it)
# Free key: https://console.groq.com
# ------------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# ------------------------------------------------------------
# Roboflow API Key (OPTIONAL — training notebook only)
# The app never reads this. notebooks/01_yolo_training.ipynb uses it
# to download the dataset; in Colab the key comes from Colab secrets,
# so this file is not consulted there. Set it only when running the
# notebook locally.
# Free key: https://app.roboflow.com/settings/api
# ------------------------------------------------------------
ROBOFLOW_API_KEY=

# ------------------------------------------------------------
# LLM Configuration
# 'llama-3.3-70b-versatile' was retired by Groq (HTTP 404).
# 'openai/gpt-oss-120b' and 'openai/gpt-oss-20b' are verified working.
# ------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=3

# ------------------------------------------------------------
# YOLO Model Configuration
# ------------------------------------------------------------
YOLO_MODEL_PATH=models/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640

# ------------------------------------------------------------
# Image Tiling
#
# TILE_SIZE must match the resolution the model was trained at.
# The shipped model was trained at YOLO_IMAGE_SIZE=640 on images that
# were 640x640 (1:1) and 1312x1312 (0.49x). A 1312 tile fed at
# YOLO_IMAGE_SIZE=640 reproduces the training scale exactly.
#
# Measured on the dataset's own validation split:
#   whole image, no tiling          F1 0.970
#   tile 640, native scale           F1 0.773
#   tile 640 after a 1.6x upscale    F1 0.462   <- the old configuration
#   tile 1312 on a 3936px sheet      F1 0.958
#
# DROP_EDGE_DETECTIONS discards symbols that a tile boundary sliced in
# half; the detector sees a partial shape, which is a false positive.
# It raised precision from 0.870 to 0.946 on a 3936px sheet.
# ------------------------------------------------------------
TILE_SIZE=1312
TILE_OVERLAP=128
DROP_EDGE_DETECTIONS=true
EDGE_TOLERANCE_PX=6

# ------------------------------------------------------------
# OCR Configuration
# Tesseract is used as primary OCR engine (install required).
# EasyOCR is the automatic fallback if Tesseract is not found.
#
# The confidence threshold is deliberately low: Tesseract's per-word
# confidence is unreliable on binarised line art, and the tag parser
# rejects noise better than a confidence gate does.
#
# OCR_MAX_DIMENSION caps the OCR stage's working image. The extractor
# upscales 3x internally for binarisation, so an A1 sheet at 300 DPI
# would otherwise be inflated to ~21000px and exhaust memory.
# ------------------------------------------------------------
OCR_LANGUAGE=en
OCR_CONFIDENCE_THRESHOLD=0.2
OCR_MAX_DIMENSION=6000

# ------------------------------------------------------------
# Preprocessing
# Denoising is off by default: it costs ~20 minutes on an A1 sheet
# at 300 DPI, and 1px line art survives CLAHE alone.
# ------------------------------------------------------------
PDF_DPI=300
CLAHE_CLIP_LIMIT=2.0
CLAHE_GRID_SIZE=8
ENABLE_DENOISE=false

# ------------------------------------------------------------
# App Configuration (FastAPI backend)
# MAX_UPLOAD_MB caps the upload size; JOB_RETENTION_SECONDS controls
# how long a job and its uploaded file are kept.
# Set API_KEY to require a key on every request.
# CORS_ORIGINS is a comma-separated allowlist; empty means same-origin only.
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_MB=25
JOB_RETENTION_SECONDS=3600
API_KEY=
CORS_ORIGINS=
